# ============================================
# 本地開發環境變量示例
# ============================================
# 複製此文件爲 .dev.vars 並填入實際值
# .dev.vars 不會被提交到 Git (已添加到 .gitignore)

# Cloudflare 賬戶 ID
# 獲取方式: https://dash.cloudflare.com → 右側邊欄
CF_ACCOUNT_ID=your_cloudflare_account_id_here

# Cloudflare API Token
# 獲取方式: https://dash.cloudflare.com/profile/api-tokens
# 權限要求: Account > Cloudflare AI > Edit
CF_API_TOKEN=your_cloudflare_api_token_here

# 登錄密碼 (用戶訪問 ChatUI 所需的密碼)
AUTH_PASSWORD=your_secure_password_here

# JWT 會話密鑰 (用於簽名驗證，建議使用隨機字符串)
# 生成命令: openssl rand -base64 32
SESSION_SECRET=your_random_secret_key_here
