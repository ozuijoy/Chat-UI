name = "cf-chatui"
main = "src/index.ts"
compatibility_date = "2024-01-01"

# ============================================
# 示例配置文件
# ============================================
# 複製此檔案為 wrangler.toml 並根據實際情況填寫
# 或者直接使用環境變數/secret 命令

[vars]
# 登入密碼（建議修改為自己的強密碼）
AUTH_PASSWORD = "Admin12345%"

# JWT 會話密鑰（建議使用隨機生成的長字串）
SESSION_SECRET = "cf-chatui-secret-key-2024"

# ============================================
# 敏感資訊配置方法（選擇其一）
# ============================================

# 方法1: 使用 wrangler secret 命令（推薦）
# wrangler secret put CF_ACCOUNT_ID
# wrangler secret put CF_API_TOKEN
# wrangler secret put AUTH_PASSWORD
# wrangler secret put SESSION_SECRET

# 方法2: 建立 .dev.vars 檔案用於本地開發
cat > .dev.vars << EOF
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
AUTH_PASSWORD=your_secure_password
SESSION_SECRET=your_random_secret_key
EOF

# ============================================
# KV Namespace 綁定（記憶模式）
# ============================================
# 為避免將 namespace id 明文寫入代碼庫，正式部署請在
# Cloudflare Dashboard 綁定：
#   Workers & Pages → chatui → Settings → Bindings
#   Variable name: CHAT_MEMORY
#
# 僅在本地開發測試記憶模式時，纔在下面加上（不要提交）：
# [[kv_namespaces]]
# binding = "CHAT_MEMORY"
# id = "你的本地測試 namespace id"
# preview_id = "你的預覽 namespace id"
